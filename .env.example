ANTHROPIC_API_KEY=sk-ant-...
DISCORD_BOT_TOKEN=...
DATABASE_PATH=mealbot.db
FLASK_PORT=5000
FLASK_DEBUG=true
DEFAULT_SERVINGS=4
DEFAULT_UNITS=imperial

# Stable Flask session-signing key (required in production; falls back to a
# random per-worker value if unset, which silently breaks sessions — see
# app.py:55 and docs/MANUAL_E2E_CHECKLIST.md)
FLASK_SECRET_KEY=

# Production Postgres connection URL (Railway auto-injects this). Unused in
# local dev, where DATABASE_PATH (SQLite) applies instead.
DATABASE_URL=

# RubotPaul HMAC bearer auth (required for auth-protected API endpoints)
RUBOTPAUL_SHARED_SECRET=

# Safeway integration (optional — only needed for ordering)
SAFEWAY_USERNAME=
SAFEWAY_PASSWORD=
SAFEWAY_STORE_ID=
