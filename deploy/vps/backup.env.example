# Copy to ~/.config/grocery-butler/backup.env on the server, fill in, then:
#   chmod 600 ~/.config/grocery-butler/backup.env
#
# The real file holds secrets. Don't put values in this example.

# Where the nightly backups are kept. The newest fourteen stay.
BACKUP_DIR=

# Encrypts every backup. Keep a copy in your password manager: without it
# the backups can't be read.
BACKUP_PASSPHRASE=

# The database to back up: the compose Postgres on its loopback port. Use the
# password from deploy/vps/.env.
#   postgresql://butler:<password>@127.0.0.1:5432/grocery_butler
DATABASE_URL=
