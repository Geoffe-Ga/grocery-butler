# Copy to deploy/vps/.env on the server, fill in, then: chmod 600 .env
#
# The real file holds secrets. It is ignored by git and is never copied
# into the image. Don't put values in this example.

# Database password. It goes inside a URL, so use only letters and digits:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# HMAC secret for /api/v1 and /api/v2 bearer tokens. Must match OpenClaw's
# copy:
#   openssl rand -hex 32
RUBOTPAUL_SHARED_SECRET=

# Session signing key for the dashboard. Generate once and keep it:
#   openssl rand -hex 32
FLASK_SECRET_KEY=

# Anthropic API key for recipe and inventory parsing. Without it the app
# still starts, and parsing falls back to saved recipes.
ANTHROPIC_API_KEY=

# Instacart shopping list links (ADR 0014). Leave all three empty to keep
# the adapter off. INSTACART_ENV is stub, development or production.
INSTACART_ENABLED=
INSTACART_ENV=
INSTACART_API_KEY=

# Optional. Gunicorn worker count (default 2), and the server port the
# database is published on for backups (default 5432).
# WEB_CONCURRENCY=
# DB_HOST_PORT=
